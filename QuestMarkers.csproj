<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>maschine-QuestMarkers</AssemblyName>
    <RootNamespace>QuestMarkers</RootNamespace>
    <Authors>maschine</Authors>
    <Company>https://github.com/maschine34675/QuestMarkers</Company>
    <!-- Windows shows this under Properties - Details - Copyright, which is
         where the bundled font's notice stays easily viewable without a
         loose file: the OFL accepts a machine-readable metadata field in a
         binary as long as the user can see it. The full licence text rides
         along as an embedded resource. -->
    <Copyright>QuestMarkers (c) maschine, MIT. Bundled font: Chakra Petch (c) 2018 The Chakra Petch Project Authors, SIL Open Font License 1.1 - https://scripts.sil.org/OFL</Copyright>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AssemblyVersion>1.3.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- No Harmony and no SPT reflection: the mod patches nothing and only
         reads game state, so only what the code actually touches is bound. -->
    <Reference Include="BepInEx">
      <HintPath>..\..\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Anvil-WebOverlay">
      <HintPath>..\..\BepInEx\plugins\Anvil-WebOverlay\Anvil-WebOverlay.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web\markers.html">
      <LogicalName>QuestMarkers.markers.html</LogicalName>
    </EmbeddedResource>
    <!-- Chakra Petch (SIL OFL 1.1), bundled unchanged; see
         web/FONT-SOURCES.md for provenance and checksums. -->
    <EmbeddedResource Include="web\ChakraPetch-Regular.ttf">
      <LogicalName>QuestMarkers.font.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="web\ChakraPetch-LICENSE.txt">
      <LogicalName>QuestMarkers.font-license.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="copy &quot;$(TargetPath)&quot; &quot;$(ProjectDir)\..\..\BepInEx\plugins\$(TargetFileName)&quot;" />
  </Target>

  <!-- The release zip extracts over the game root and contains exactly the
       plugin DLL under BepInEx\plugins - nothing in the zip root. -->
  <Target Name="CreateReleaseZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageRoot>$(ProjectDir)obj\package\</PackageRoot>
      <PackagePluginDir>$(PackageRoot)BepInEx\plugins\</PackagePluginDir>
      <ReleaseZipPath>$(ProjectDir)artifacts\maschine-QuestMarkers-$(AssemblyVersion).zip</ReleaseZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageRoot)" />
    <MakeDir Directories="$(PackagePluginDir);$(ProjectDir)artifacts" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackagePluginDir)" />
    <Delete Files="$(ReleaseZipPath)" />
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(ReleaseZipPath)" />
    <Message Importance="high" Text="Release package created: $(ReleaseZipPath)" />
  </Target>

</Project>
